{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "sherlock_http": {
          "automatic_https": {
            "disable_redirects": true
          },
          "client_ip_headers": [
            "X-Forwarded-For"
          ],
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "client_ip_headers": [
                            "X-Forwarded-For"
                          ],
                          "fail_mode": "closed",
                          "handler": "sherlock_core",
                          "mode": "block",
                          "site_id": "shop",
                          "trusted_proxies": [
                            "10.0.0.0/8"
                          ]
                        },
                        {
                          "blocking_paranoia_level": 1,
                          "fail_mode": "closed",
                          "handler": "sherlock_waf",
                          "inbound_threshold": 5,
                          "max_body_bytes": 10485760,
                          "mode": "block",
                          "outbound_threshold": 4,
                          "paranoia_level": 1,
                          "site_id": "shop",
                          "skip_inspection_extensions": [
                            ".css",
                            ".js",
                            ".png",
                            ".jpg",
                            ".jpeg",
                            ".gif",
                            ".svg",
                            ".ico",
                            ".woff",
                            ".woff2"
                          ]
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "Referrer-Policy": [
                                "strict-origin-when-cross-origin"
                              ],
                              "X-Content-Type-Options": [
                                "nosniff"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "least_conn"
                            }
                          },
                          "transport": {
                            "dial_timeout": "5s",
                            "protocol": "http",
                            "read_timeout": "1m0s",
                            "write_timeout": "1m0s"
                          },
                          "upstreams": [
                            {
                              "dial": "10.0.1.10:8080"
                            },
                            {
                              "dial": "10.0.1.11:8080"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.com",
                    "www.shop.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "client_ip_headers": [
                            "X-Forwarded-For"
                          ],
                          "fail_mode": "open",
                          "handler": "sherlock_core",
                          "mode": "detect",
                          "site_id": "blog",
                          "trusted_proxies": [
                            "10.0.0.0/8"
                          ]
                        },
                        {
                          "blocking_paranoia_level": 1,
                          "fail_mode": "open",
                          "handler": "sherlock_waf",
                          "inbound_threshold": 5,
                          "max_body_bytes": 10485760,
                          "mode": "detect",
                          "outbound_threshold": 4,
                          "paranoia_level": 1,
                          "site_id": "blog",
                          "skip_inspection_extensions": [
                            ".css",
                            ".js",
                            ".png",
                            ".jpg",
                            ".jpeg",
                            ".gif",
                            ".svg",
                            ".ico",
                            ".woff",
                            ".woff2"
                          ]
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "Referrer-Policy": [
                                "strict-origin-when-cross-origin"
                              ],
                              "X-Content-Type-Options": [
                                "nosniff"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "active": {
                              "interval": "10s",
                              "timeout": "2s",
                              "uri": "/healthz"
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            }
                          },
                          "transport": {
                            "dial_timeout": "5s",
                            "protocol": "http",
                            "read_timeout": "1m0s",
                            "write_timeout": "1m0s"
                          },
                          "upstreams": [
                            {
                              "dial": "10.0.2.10:8080"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "*.blog.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "421 Misdirected Request\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 421
                }
              ],
              "terminal": true
            }
          ],
          "trusted_proxies": {
            "ranges": [
              "10.0.0.0/8"
            ],
            "source": "static"
          },
          "trusted_proxies_strict": 1
        }
      }
    }
  }
}
