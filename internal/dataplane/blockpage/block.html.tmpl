<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{.Status}} {{.Title}}</title>
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f6f7f9;color:#1b1f24;font:16px/1.5 system-ui,sans-serif}
main{max-width:34rem;margin:1rem;padding:2rem;background:#fff;border:1px solid #d5d9e0;border-radius:.5rem}
h1{margin:0 0 .5rem;font-size:1.4rem}
code{padding:.1rem .35rem;background:#eef0f3;border-radius:.25rem;font-size:.95rem;user-select:all}
@media (prefers-color-scheme:dark){body{background:#14171b;color:#e6e8eb}main{background:#1c2026;border-color:#343a43}code{background:#2a3038}}
</style>
</head>
<body>
<main>
<h1>{{.Status}} {{.Title}}</h1>
<p>{{.Detail}}</p>
<p>If you believe this is a mistake, contact the site operator and quote this event ID:</p>
<p><code>{{.EventID}}</code></p>
</main>
</body>
</html>
