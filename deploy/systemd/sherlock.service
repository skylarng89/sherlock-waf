[Unit]
Description=Sherlock WAF
Documentation=https://github.com/skylarng89/sherlock-waf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sherlock
Group=sherlock
EnvironmentFile=-/etc/sherlock/sherlock.env
ExecStart=/usr/bin/sherlock run --data-dir /var/lib/sherlock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: the process sees a read-only system and may write only its own state.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sherlock
StateDirectory=sherlock
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
