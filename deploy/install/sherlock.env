# Environment for the sherlock service. Uncomment and edit; restart with `systemctl restart sherlock`.
#
# Control plane (API and dashboard) address. Keep it on loopback or a private interface.
#SHERLOCK_ADMIN_LISTEN=127.0.0.1:9443
# Only these networks may connect to the control plane (comma-separated CIDRs).
#SHERLOCK_ADMIN_ALLOWED_CIDRS=10.0.0.0/8
# PostgreSQL instead of the default SQLite file in /var/lib/sherlock.
#SHERLOCK_DATABASE_URL=postgres://sherlock:CHANGE_ME@db.internal/sherlock?sslmode=verify-full
# Keep the node key outside the data directory (a file readable only by the sherlock user).
#SHERLOCK_NODE_KEY_FILE=/etc/sherlock/node.key
